#!/usr/bin/env bash
#
# Deploy the Blipkeep panel from a single image, without sources.
#
#   docker run --rm sirruf/tinymon-server:latest cat /app/bin/bootstrap \
#     | bash -s -- --host mon.example.com
#
# The script runs on the host, not inside the container: it pulls the stack
# manifest out of the image, generates .env with secrets and deploys the Swarm
# stack. Everything else — migrations, default alert rules, the first
# administrator — the container does itself on start (rel/overlays/bin/server).
#
# Running it again is safe: an existing .env is never overwritten and
# Tinymon.Release.setup/0 is idempotent.
#
# English only, deliberately: this file is published as part of the public
# installation kit, and the panel is installed by people who do not
# necessarily read Russian. The Russian walkthrough lives in the docs.

set -euo pipefail

IMAGE="${TINYMON_IMAGE:-sirruf/tinymon-server}"
VERSION="${TINYMON_VERSION:-latest}"
DIR="${TINYMON_DIR:-/opt/tinymon}"
STACK_NAME="${STACK_NAME:-tinymon}"

HOST=""
ADMIN_EMAIL=""
SCHEME="https"
PORT="4000"

usage() {
  cat >&2 <<'EOF'
Deploy the Blipkeep panel from an image.

  --host <address>       panel address: goes into links and the agent install command
  --admin <email>        first administrator's email (default: admin@<host>)
  --scheme <https|http>  scheme used in links (default: https)
  --port <port>          external port of the panel (default: 4000)
  --image <image>        server image (default: sirruf/tinymon-server)
  --version <tag>        image tag (default: latest)
  --dir <path>           deployment directory (default: /opt/tinymon)
  --stack <name>         Swarm stack name (default: tinymon)
EOF
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)    HOST="$2";        shift 2 ;;
    --admin)   ADMIN_EMAIL="$2"; shift 2 ;;
    --scheme)  SCHEME="$2";      shift 2 ;;
    --port)    PORT="$2";        shift 2 ;;
    --image)   IMAGE="$2";       shift 2 ;;
    --version) VERSION="$2";     shift 2 ;;
    --dir)     DIR="$2";         shift 2 ;;
    --stack)   STACK_NAME="$2";  shift 2 ;;
    -h|--help) usage ;;
    *) echo "unknown option: $1" >&2; usage ;;
  esac
done

[[ -n "$HOST" ]] || { echo "--host is required" >&2; usage; }

ADMIN_EMAIL="${ADMIN_EMAIL:-admin@${HOST}}"

# ---- Environment checks ----------------------------------------------------

[[ $EUID -eq 0 ]] || {
  echo "root privileges required: run through sudo" >&2
  exit 1
}

for tool in docker openssl; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "$tool is required but missing" >&2
    exit 1
  }
done

# Swarm is required: the manifest is a stack.yml, not a compose file. It is
# initialised automatically, but on a host with several addresses Docker cannot
# choose one — there we print the exact command instead of guessing
if [[ "$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)" != "active" ]]; then
  echo "==> Swarm is not initialised, initialising"

  if ! docker swarm init >/dev/null 2>&1; then
    echo "    could not pick an address automatically." >&2
    echo "    Run this manually and try again:" >&2
    echo "      docker swarm init --advertise-addr <address>" >&2
    exit 1
  fi
fi

# ---- Image -----------------------------------------------------------------

echo "==> pulling ${IMAGE}:${VERSION}"

# Up front: if the tag is missing or the registry is unreachable, we find out
# before anything has been created on disk
docker pull "${IMAGE}:${VERSION}"

mkdir -p "$DIR"
cd "$DIR"

echo "==> extracting the stack manifest from the image"

# The version in the release path changes, so the glob is expanded inside
# the container
docker run --rm "${IMAGE}:${VERSION}" \
  sh -c 'cat /app/lib/tinymon-*/priv/deploy/stack.yml' > stack.yml

[[ -s stack.yml ]] || {
  echo "the manifest is empty — the image was built without priv/deploy" >&2
  exit 1
}

# ---- Environment -----------------------------------------------------------

# An existing .env is left alone: it already holds working secrets, and
# overwriting it would invalidate every session and cut the server off from
# its own database
if [[ -f .env ]]; then
  echo "==> .env already exists, leaving it as is"
else
  echo "==> generating .env"

  umask 077
  cat > .env <<EOF
# Created by bootstrap $(date -Iseconds)
PHX_HOST=${HOST}
PHX_SCHEME=${SCHEME}
POSTGRES_PASSWORD=$(openssl rand -base64 32 | tr -d '/+=' | head -c 32)
SECRET_KEY_BASE=$(openssl rand -base64 64 | tr -d '\n')
ADMIN_EMAIL=${ADMIN_EMAIL}
PUBLISHED_PORT=${PORT}
TINYMON_IMAGE=${IMAGE}
TINYMON_VERSION=${VERSION}
EOF
  chmod 600 .env
fi

set -a
# shellcheck disable=SC1091
source .env
set +a

# Flags win over whatever is written in .env: otherwise running this again with
# a different version would silently deploy the old one
export TINYMON_IMAGE="$IMAGE"
export TINYMON_VERSION="$VERSION"

# ---- Deployment ------------------------------------------------------------

echo "==> deploying stack $STACK_NAME"

# --with-registry-auth matters for a private registry: without it the node
# gets no credentials and cannot pull. Harmless for a public image
docker stack deploy --with-registry-auth -c stack.yml "$STACK_NAME"

# Database readiness is checked with its own pg_isready rather than by the
# presence of a container: the process starts long before it accepts connections
echo "==> waiting for the database"

attempts=0
while :; do
  container="$(docker ps -q -f "name=${STACK_NAME}_db" | head -1)"

  if [[ -n "$container" ]] && \
     docker exec "$container" pg_isready -U tinymon -d tinymon >/dev/null 2>&1; then
    echo "    database is ready"
    break
  fi

  attempts=$((attempts + 1))

  # 10 minutes: that is how long pulling the TimescaleDB image can take
  if [[ $attempts -gt 300 ]]; then
    echo "    the database did not come up within 10 minutes" >&2
    docker service ps "${STACK_NAME}_db" --no-trunc | head -5 >&2
    exit 1
  fi

  [[ $((attempts % 15)) -ne 0 ]] || echo "    still waiting ($((attempts * 2)) s)..."
  sleep 2
done

echo "==> waiting for the server"

attempts=0
until [[ "$(docker service ls --filter "name=${STACK_NAME}_tinymon" --format '{{.Replicas}}' | cut -d/ -f1)" == "1" ]]; do
  attempts=$((attempts + 1))

  if [[ $attempts -gt 90 ]]; then
    echo "    the service did not start, check docker service logs ${STACK_NAME}_tinymon" >&2
    exit 1
  fi

  sleep 2
done

# ---- Credentials -----------------------------------------------------------

# The first administrator's password lives in a file inside the container, not
# in the log: the log stays on the node's disk until rotation, travels to log
# collectors, and anyone with docker access can read it
container="$(docker ps -q -f "name=${STACK_NAME}_tinymon" | head -1)"
credentials_in_container="/app/.initial-credentials"

if [[ -n "$container" ]] && docker exec "$container" test -f "$credentials_in_container" 2>/dev/null; then
  {
    echo "# Blipkeep first administrator credentials"
    echo "# Created: $(date -Iseconds)"
    echo "# Change the password on first sign-in and delete this file."
    echo
    docker exec "$container" cat "$credentials_in_container"
  } > "$DIR/.initial-credentials"

  chmod 600 "$DIR/.initial-credentials"

  # The file is no longer needed inside the container
  docker exec "$container" rm -f "$credentials_in_container" 2>/dev/null || true

  echo
  echo "    credentials written to $DIR/.initial-credentials (0600)"
else
  echo "    the administrator already existed, the password was left alone"
fi

# ---- Summary ---------------------------------------------------------------

cat <<EOF

==> done

    panel:     ${SCHEME}://${HOST}
    directory: ${DIR}
    version:   ${IMAGE}:${VERSION}

    Token for installing an agent:
      docker exec \$(docker ps -q -f name=${STACK_NAME}_tinymon | head -1) \\
        /app/bin/tinymon eval 'Tinymon.Release.enrollment_token()'

    To move to another version, run this again with --version <tag>.
EOF
