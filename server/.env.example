# Blipkeep deployment settings. Copy to .env and fill in.
#
#   cp .env.example .env
#
# The file holds secrets and must not end up in a repository.
#
# Kept in sync by hand with server/priv/deploy/.env.example — pack.sh warns
# when the Russian original is newer than this translation.

# The address the panel is reachable at. It goes into the links sent to
# Telegram and into the agent install command the panel displays.
PHX_HOST=mon.example.com

# Scheme used in links. https behind Caddy or Cloudflare, http for a local
# installation without TLS.
PHX_SCHEME=https

# Database password. Generate one:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=

# Session signing key. Changing it invalidates all current sessions — that is
# acceptable, but everyone will have to sign in again. Generate one:
#   openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=

# First administrator's email. The password is generated on first deployment
# and printed once — the installer writes it to .initial-credentials.
ADMIN_EMAIL=admin@example.com

# Address for Let's Encrypt. Used only by compose.yml with Caddy.
ACME_EMAIL=admin@example.com

# ---- Optional --------------------------------------------------------------

# The port the panel is published on. stack.yml only — with compose.yml it is
# Caddy that faces the outside.
PUBLISHED_PORT=4000

# Caddy ports. Change these if 80 and 443 are already taken on the host.
HTTP_PORT=80
HTTPS_PORT=443

# Image tag. Lets you roll back to a previous build.
TINYMON_VERSION=latest

# Header carrying the client address, to be trusted. Set it only where a proxy
# in front of the panel overwrites that header: otherwise a client sets its own
# address and bypasses the rate limiter.
TINYMON_CLIENT_IP_HEADER=

# Built-in TLS instead of a reverse proxy. The paths point inside the
# container; the certificate directory is mounted from TINYMON_TLS_DIR.
# Leave empty for plain http.
TINYMON_TLS_DIR=/etc/tinymon-tls
TINYMON_TLS_CERTFILE=
TINYMON_TLS_KEYFILE=

# Port used in links when the panel listens on a non-standard one. Without it
# https links would carry 443.
PHX_URL_PORT=
